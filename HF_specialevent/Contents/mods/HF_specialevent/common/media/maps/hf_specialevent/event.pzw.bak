 <propertydef name="Direction" default="N" enum="Direction">
  <description>Cardinal direction used by vehicle, mannequin, and stair properties.</description>
 </propertydef>
 <propertydef name="Professions" default="unemployed" enum="Professions">
  <description>Professions allowed to use this spawn point. Choose one or more explicit values.</description>
 </propertydef>
 <propertydef name="FaceDirection" default="true">
  <description>When enabled, vehicles face the selected Direction.</description>
 </propertydef>
 <propertydef name="WaterDirection" default="0.0">
  <description>Water flow direction in degrees.</description>
 </propertydef>
 <propertydef name="WaterSpeed" default="0.0">
  <description>Water flow speed. Zero creates still water.</description>
 </propertydef>
 <propertydef name="WaterGround" default="false">
  <description>Marks the zone as water ground for the water renderer.</description>
 </propertydef>
 <propertydef name="WaterShore" default="true">
  <description>Enables shoreline behavior around the water zone.</description>
 </propertydef>
 <propertydef name="Female" default="true">
  <description>Selects the mannequin gender when no script overrides it.</description>
 </propertydef>
 <propertydef name="Outfit" default=""/>
 <propertydef name="Pose" default="pose01" enum="Pose"/>
 <propertydef name="Script" default=""/>
 <propertydef name="Skin" default="White" enum="Skin">
  <description>Selects the mannequin skin variant.</description>
 </propertydef>
 <propertydef name="RoomTone" default="Generic" enum="RoomTone">
  <description>Build 42 room audio profile applied at this location.</description>
 </propertydef>
 <propertydef name="EntireBuilding" default="false">
  <description>Applies the selected RoomTone to the complete building.</description>
 </propertydef>
 <propertydef name="Action" default="" enum="AnimalAction">
  <description>Animal route action used by this zone or polyline.</description>
 </propertydef>
 <propertydef name="AnimalType" default="" enum="Animal">
  <description>Animal category associated with a Follow route.</description>
 </propertydef>
 <propertydef name="SpawnAnimals" default="true">
  <description>Allows animals to spawn from this Animal zone.</description>
 </propertydef>
 <propertydef name="Access" default="">
  <description>Name of basement access file.</description>
 </propertydef>
 <propertydef name="StairDirection" default="N" enum="Direction">
  <description>Direction of the basement access stair.</description>
 </propertydef>
 <propertydef name="StairX" default="0">
  <description>Stair X coordinate within the basement zone.</description>
 </propertydef>
 <propertydef name="StairY" default="0">
  <description>Stair Y coordinate within the basement zone.</description>
 </propertydef>
 <propertydef name="Rocks" default="false">
  <description>Enables WorldGen rock placement in this zone.</description>
 </propertydef>
